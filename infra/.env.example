# === MQTT ===
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_USER=backend
MQTT_PASS=change_me

# === Database ===
DATABASE_URL=sqlite:///./svmg.db
# DATABASE_URL=postgresql://user:pass@localhost:5432/svmg

# === Auth ===
JWT_SECRET=change-this-to-a-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# === Telegram Notifications ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# === Email Webhook ===
EMAIL_WEBHOOK_URL=

# === Backend ===
MQTT_ENABLED=true
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173
# CONTRACTS_DIR=   # mac dinh <repo>/contracts/schemas

# === Bao mat (M3-05) ===
# ENV=production -> bat buoc JWT_SECRET >= 32 ky tu. Tao: python -c "import secrets;print(secrets.token_urlsafe(48))"
ENV=dev
ADMIN_USERNAME=admin
# Dat de tu tao admin dau tien khi bang users rong (hoac dung scripts/create_user.py)
ADMIN_PASSWORD=
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_S=300

# === Thong bao (M3-08) ===
NOTIFY_COOLDOWN_S=30
ALARM_ESCALATE_AFTER_S=60

# === Van hanh nen (bo sung) ===
# Bat/tat quet nen: leo thang canh bao + TIMEOUT lenh
ALARM_ESCALATION_ENABLED=true
# Chu ky quet nen (giay)
ALARM_ESCALATION_CHECK_S=5
# Thiet bi im qua N giay = stale (health gui moi 30s -> 3 chu ky)
HEALTH_STALE_S=90
# Timeout moi lan gui thong bao (giay)
NOTIFY_TIMEOUT_S=5
# So lan thu lai sau lan dau that bai
NOTIFY_RETRIES=2
# Cho 1s, 2s, ... giua cac lan thu lai
NOTIFY_BACKOFF_S=1

# === Production (bao mat) ===
# Ma hoa ket noi MQTT (cong 8883) va tat /docs
MQTT_TLS=false
# MQTT_CA_CERTS=/duong/dan/ca.crt
# DOCS_ENABLED=true   # mac dinh tu dong: bat o dev, tat khi ENV=production

# === Don du lieu cu (retention) - MAC DINH TAT (0 = giu mai) ===
# Chi ap dung cho device_health va telemetry KHONG thuoc chuyen nao. Telemetry cua chuyen, canh bao, lenh, audit KHONG bao gio bi xoa.
RETENTION_HEALTH_DAYS=0
RETENTION_TELEMETRY_DAYS=0
RETENTION_BATCH=5000
RETENTION_INTERVAL_S=3600
AUTO_REGISTER_DEVICES=true   # false = chi nhan thiet bi Admin da dang ky truoc (POST /api/v1/devices)
