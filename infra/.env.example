# === MQTT ===
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_USER=backend
MQTT_PASS=change_me

# === Database ===
DATABASE_URL=sqlite:///./svmg.db
# DATABASE_URL=postgresql://user:pass@localhost:5432/svmg

# === Auth ===
JWT_SECRET=change-this-to-a-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# === Telegram Notifications ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# === Email Webhook ===
EMAIL_WEBHOOK_URL=

# === Backend ===
MQTT_ENABLED=true
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173
# CONTRACTS_DIR=   # mac dinh <repo>/contracts/schemas

# === Bao mat (M3-05) ===
# ENV=production -> bat buoc JWT_SECRET >= 32 ky tu. Tao: python -c "import secrets;print(secrets.token_urlsafe(48))"
ENV=dev
ADMIN_USERNAME=admin
# Dat de tu tao admin dau tien khi bang users rong (hoac dung scripts/create_user.py)
ADMIN_PASSWORD=
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_S=300

# === Thong bao (M3-08) ===
NOTIFY_COOLDOWN_S=30
ALARM_ESCALATE_AFTER_S=60
