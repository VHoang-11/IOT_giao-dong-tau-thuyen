{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SVMG Command",
  "description": "Lệnh điều khiển gửi xuống thiết bị qua svmg/{device_id}/cmd",
  "type": "object",
  "required": ["cmd_id", "cmd", "ttl_s", "issued_by"],
  "properties": {
    "cmd_id": {"type": "string"},
    "cmd": {"type": "string", "enum": ["set_profile", "set_threshold", "calibrate_zero", "mute_alarm", "start_voyage", "stop_voyage", "restart_device"]},
    "params": {"type": "object"},
    "ttl_s": {"type": "integer", "minimum": 1, "maximum": 300},
    "issued_by": {"type": "string"}
  }
}
